# Copy to apps/web/.env.local. `pnpm stack:start` fills the Supabase values for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Server only. Never expose to web or glasses clients.
SUPABASE_SERVICE_ROLE_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=replace-with-pinned-model-id
# Demo-only guest accounts (name-only sign-up) are on unless this is off, false or 0. Set to off on Vercel and redeploy to stop new guests.
CUE_GUESTS_ENABLED=on

# apps/mentra: optional, set in the shell when building the glasses mini app.
# Defaults to the live site; point it at your own server for local work.
# MENTRA_PUBLIC_CUE_SERVER_URL=http://<laptop-ip>:3000
